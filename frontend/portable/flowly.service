[Unit]
Description=Flowly website and lead API
After=network.target
[Service]
Type=simple
User=flowly
Group=flowly
WorkingDirectory=/opt/flowly
EnvironmentFile=/etc/flowly.env
ExecStart=/usr/bin/node --env-file=/etc/flowly.env /opt/flowly/server.mjs
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/flowly
[Install]
WantedBy=multi-user.target
