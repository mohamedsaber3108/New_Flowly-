# ===========================================================================
# Flowly backend environment. Copy to .env and fill in. NEVER commit .env.
# Loaded by python-decouple (process env wins over the file).
# ===========================================================================

# --- Django ----------------------------------------------------------------
# Required in production. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
# Production forces DEBUG off regardless of this value.
DEBUG=False
# Comma-separated hostnames served by this app. Never '*' in production.
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# Secret path for the Django admin (change from admin/). Trailing slash optional.
ADMIN_URL=your-secret-admin-path/
# Number of trusted reverse proxies in front of Gunicorn (Nginx = 1). Used for client IPs/throttling.
NUM_PROXIES=1
# Set False only while testing before the SSL certificate exists.
SECURE_SSL_REDIRECT=True

# --- Database --------------------------------------------------------------
# PostgreSQL 16 in production. Development falls back to sqlite:///db.sqlite3 when unset.
DATABASE_URL=postgres://flowly:password@localhost:5432/flowly

# --- URLs ------------------------------------------------------------------
# Public origin of the website (React build served by Nginx).
FRONTEND_URL=https://yourdomain.com
# Public origin of this Django site (used in emailed links + Google callback). Same domain behind Nginx.
SITE_URL=https://yourdomain.com
# Origin used in sitemap.xml / robots.txt (blank = taken from the request).
PUBLIC_ORIGIN=https://yourdomain.com
# Comma-separated origins allowed to call the API cross-origin (and to pass the same-origin form check).
CORS_ALLOWED_ORIGINS=https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- Auth ------------------------------------------------------------------
# Google OAuth (console.cloud.google.com > Credentials > OAuth client ID, type Web).
# Authorized redirect URI: https://yourdomain.com/api/v1/auth/social/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Block login until the email address is verified. Leave unset: it turns on automatically when
# EMAIL_HOST_USER is set (set False/True here to force).
# REQUIRE_EMAIL_VERIFICATION=True

# --- Staff sign-in: two-step verification, lockout, session limits (FL-09) ----
# Fernet key that encrypts the authenticator secrets. Generate once on the server and keep it (losing it means every
# enrolled person must set up again):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Owner/staff must give a verification code at every sign-in. Leave False (or unset) until everyone has enrolled at
# /account/mfa/enroll/, then set True. The app refuses to start with True and an empty MFA_ENCRYPTION_KEY.
# REQUIRE_STAFF_MFA=False
# 5 failed sign-ins in 15 minutes lock that account for 15 minutes (all entrances). Defaults shown.
# LOGIN_LOCKOUT_ATTEMPTS=5            (per email AND per IP address)
# LOGIN_LOCKOUT_IP_ATTEMPTS=20        (per IP address, across all emails)
# LOGIN_LOCKOUT_EMAIL_ATTEMPTS=50     (per email, across all IP addresses)
# LOGIN_LOCKOUT_SECONDS=900
# Django admin sessions of staff: idle limit and absolute limit, in seconds. Defaults shown.
# ADMIN_SESSION_IDLE_SECONDS=1800
# ADMIN_SESSION_MAX_SECONDS=28800

# --- Team console (/team) ----------------------------------------------------
# Team members sign in at /team with a named staff account. The old shared token below is IGNORED unless
# ALLOW_SHARED_ADMIN_TOKEN=True. Turn it on only while moving to named accounts, then remove ADMIN_TOKEN.
# ALLOW_SHARED_ADMIN_TOKEN=False
# Optional shared bearer token for the old /team field (min 32 chars). Only used when the line above is True.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_TOKEN=
# Folder for the daily audit export (manage.py export_audit_log). Default: backend/audit_exports. Optional.
# AUDIT_EXPORT_DIR=/var/backups/flowly-audit
# Comma-separated addresses that get an email for every new request.
TEAM_NOTIFY_EMAIL=

# --- Password hashing --------------------------------------------------------
# False (default): new hashes stay PBKDF2, existing Argon2 hashes still verify, nothing is upgraded. Safe to roll back.
# True: Argon2 becomes the default and each user's hash is upgraded at their next sign-in. After this has been True,
# roll back only to a commit that still lists Argon2 (the FL-20 merge or newer). Runbook: FL-20 deploy notes.
# PASSWORD_HASH_ARGON2=False

# --- Email (SMTP now; swap to AWS SES later by changing EMAIL_BACKEND) -------
# Leave EMAIL_BACKEND unset: SMTP is used when EMAIL_HOST_USER is set, otherwise emails go to the log.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Flowly <noreply@yourdomain.com>

# --- Assistant (optional; empty = deterministic catalog guide) ----------------
# bedrock | compatible | dify | (blank)
AI_PROVIDER=
# compatible: any OpenAI-style /chat/completions endpoint
AI_API_URL=
AI_API_KEY=
AI_MODEL=
# dify
DIFY_API_URL=
DIFY_API_KEY=
# bedrock (uses the EC2 IAM role / default AWS credential chain)
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
# Store assistant exchanges for review (off by default for privacy).
ASSISTANT_LOG_ENABLED=False

# --- Throttling (optional overrides) ------------------------------------------
THROTTLE_REQUEST=8/hour
THROTTLE_LOOKUP=20/hour
THROTTLE_ASSISTANT=30/hour
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_RESET=5/hour

# --- File uploads -------------------------------------------------------------
MEDIA_ROOT=/var/www/flowly/media
MAX_UPLOAD_SIZE_MB=10

# --- Logging ------------------------------------------------------------------
LOG_DIR=/var/log/flowly
LOG_TO_FILE=True

# --- First superuser (used by `manage.py seed_demo`) -----------------------------
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=
